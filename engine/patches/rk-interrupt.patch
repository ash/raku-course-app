diff -ruN a/src/Interrupt.h b/src/Interrupt.h
--- a/src/Interrupt.h	1970-01-01 03:00:00.000000000 +0300
+++ b/src/Interrupt.h	2026-10-17 22:04:32.990927811 +0300
@@ -0,0 +1,23 @@
+// Interrupt.h — stopping a running program from outside it (rk_interrupt).
+//
+// A host that runs user programs — a playground, a notebook, an app — needs a
+// Stop button, and rk_run had no way to end an evaluation early. This is the
+// smallest one that works: a process-wide flag the host raises, read with a
+// relaxed load at the points every long-running program passes through (each
+// statement, each block entry, each iteration of an Int loop kernel). Once
+// raised it stays raised until the next rk_run/rk_eval begins, so a `try`
+// that swallows the first X::AdHoc cannot keep the program alive: the very
+// next statement throws again.
+#pragma once
+#include <atomic>
+
+namespace rakupp {
+
+extern std::atomic<bool> g_interruptRequested;
+[[noreturn]] void throwInterrupted();
+
+inline void checkInterrupt() {
+    if (g_interruptRequested.load(std::memory_order_relaxed)) throwInterrupted();
+}
+
+} // namespace rakupp
