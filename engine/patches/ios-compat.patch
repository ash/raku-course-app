--- a/src/Jit.cpp	2026-10-17 22:10:12.230146006 +0300
+++ b/src/Jit.cpp	2026-10-17 22:11:20.719671717 +0300
@@ -43,6 +43,15 @@
 #include <thread>
 #include <vector>
 
+// RAKUPP_IOS: an iOS (or simulator) build, where an app may not run a
+// compiler, map executable memory, or call getentropy.
+#if defined(__APPLE__)
+#  include <TargetConditionals.h>
+#  if TARGET_OS_IPHONE && !defined(RAKUPP_IOS)
+#    define RAKUPP_IOS 1
+#  endif
+#endif
+
 namespace rakupp {
 namespace jit {
 
@@ -620,12 +629,17 @@
 }
 
 int run(const std::string& cmd) {
+#if RAKUPP_IOS
+    (void)cmd;
+    return -1;   // no system(), and no compiler to call: --jit has nothing to do on iOS
+#else
     if (g_opt.verbose) return std::system(cmd.c_str());
     // The GROUP is redirected, not the last command in it. Every command here
     // is a `&&`/`;` chain, and `a && b >/dev/null 2>&1` redirects only `b` — so
     // the compiler's own diagnostics were reaching the user's terminal on a
     // failed kernel, in the middle of their program's output.
     return std::system(("{ " + cmd + " ; }" + " >/dev/null 2>&1").c_str());
+#endif
 }
 
